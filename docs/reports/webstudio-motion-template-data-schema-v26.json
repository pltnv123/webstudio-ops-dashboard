{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webstudio.local/schemas/webstudio-motion-template-data-schema-v26.json",
  "title": "WebStudio Motion Generator Brief v26",
  "type": "object",
  "required": ["client", "product_service_name", "offer", "proof_points", "cta", "brand", "motion", "outputs"],
  "additionalProperties": false,
  "properties": {
    "client": {
      "type": "object",
      "required": ["name", "industry", "audience"],
      "properties": {
        "name": {"type": "string"},
        "industry": {"type": "string"},
        "audience": {"type": "string"},
        "source_brief_path": {"type": "string"}
      }
    },
    "product_service_name": {"type": "string"},
    "offer": {
      "type": "object",
      "required": ["headline", "subheadline", "primary_value", "scope"],
      "properties": {
        "headline": {"type": "string"},
        "subheadline": {"type": "string"},
        "primary_value": {"type": "string"},
        "scope": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "proof_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "evidence", "status"],
        "properties": {
          "label": {"type": "string"},
          "evidence": {"type": "string"},
          "status": {"enum": ["verified", "client_provided", "placeholder_for_owner_review", "not_allowed"]}
        }
      }
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objection", "answer"],
        "properties": {
          "objection": {"type": "string"},
          "answer": {"type": "string"},
          "risk": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "cta": {
      "type": "object",
      "required": ["text", "destination", "approval_state"],
      "properties": {
        "text": {"type": "string"},
        "destination": {"type": "string"},
        "approval_state": {"enum": ["draft", "owner_approved", "client_approved"]}
      }
    },
    "brand": {
      "type": "object",
      "required": ["style_direction", "palette", "tone"],
      "properties": {
        "style_direction": {"type": "string"},
        "palette": {"type": "array", "items": {"type": "string"}},
        "tone": {"type": "string"},
        "forbidden_visuals": {"type": "array", "items": {"type": "string"}},
        "assets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "motion": {
      "type": "object",
      "required": ["style", "template", "duration_seconds", "fps"],
      "properties": {
        "style": {"enum": ["premium_editorial_reveal", "technical_dark_atelier", "luxury_minimal", "bold_kinetic", "process_explainer", "social_teaser_9x16"]},
        "template": {"type": "string"},
        "duration_seconds": {"type": "number", "minimum": 3, "maximum": 30},
        "fps": {"type": "integer", "enum": [24, 30, 60]},
        "reduced_motion_required": {"type": "boolean", "default": true}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "format"],
        "properties": {
          "type": {"enum": ["hero_video", "social_teaser", "proof_reel", "process_explainer"]},
          "format": {"enum": ["16:9", "9:16", "1:1"]},
          "width": {"type": "integer"},
          "height": {"type": "integer"},
          "poster_required": {"type": "boolean", "default": true}
        }
      }
    },
    "handoff": {
      "type": "object",
      "properties": {
        "usage_channels": {"type": "array", "items": {"enum": ["hero", "social_ad", "presentation", "telegram_demo"]}},
        "rights_status": {"enum": ["internal_demo", "client_assets_provided", "licensed", "needs_review"]},
        "approval_next_action": {"type": "string"}
      }
    }
  }
}
